{
  "manifest_version": 3,
  "name": "X Bookmark Folders",
  "short_name": "X Folders",
  "version": "0.1.0",
  "description": "Opens X's Add to Folder picker as soon as you bookmark a post.",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
